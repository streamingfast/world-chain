# syntax=docker/dockerfile:1.7
# StreamingFast Firehose image: world-chain node bundled into the firehose-ethereum
# (fireeth) image, mirroring streamingfast/base's Dockerfile.sf.
ARG FIREHOSE_ETHEREUM="latest"
# Selects the base image only. Since upstream v2.4.2 the workspace ships a
# rust-toolchain.toml pinning nightly-2026-07-01 (crates/evm needs
# #![feature(min_specialization)]), which rustup installs on the first cargo
# invocation below — that nightly, not this version, is what compiles the node.
ARG RUST_VERSION=1.95.0

FROM public.ecr.aws/docker/library/rust:${RUST_VERSION}-bookworm AS builder
WORKDIR /app
ARG TARGETARCH

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      git libclang-dev clang pkg-config curl build-essential cmake

COPY . .

# .dockerignore excludes .git, so the git SHA must be supplied for vergen
# (crates/node/build.rs falls back to git describe otherwise and fails).
ARG VERGEN_GIT_SHA="unknown"
ARG PROFILE="release"
ARG FEATURES="jemalloc"

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,id=world-chain-fh-target-${TARGETARCH} \
    cargo build --locked --profile ${PROFILE} --features ${FEATURES} --bin world-chain && \
    cp /app/target/${PROFILE}/world-chain /app/world-chain

FROM ghcr.io/streamingfast/firehose-ethereum:${FIREHOSE_ETHEREUM}

COPY --from=builder /app/world-chain /usr/local/bin/world-chain
RUN ln -s /usr/local/bin/world-chain /app/world-chain

EXPOSE 8545 8546 9001 30303 30303/udp
